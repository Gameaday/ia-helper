<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    
    <!-- 
        ============================================================================
        REQUIRED PERMISSIONS - Internet Archive Helper
        ============================================================================
        This app downloads files from the Internet Archive and saves them locally.
        Permissions are requested at runtime following Android best practices.
    -->
    
    <!-- INTERNET: Required for downloading files from archive.org -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- 
        STORAGE MODEL (Nov 2026, #81/#82):
        All downloads, caches and previews use app-scoped directories
        (path_provider), writable on every supported Android version
        (API 21+) with NO storage permission. Public-folder saves will
        use SAF with persistable URI grants (#90), which also needs none.
        The legacy WRITE/READ storage permissions are therefore not
        declared at all.
    -->
    
    <!-- 
        OPTIONAL PERMISSIONS
    -->
    
    <!-- Network state: Allows app to detect connection type and status -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 
        All Files Access: Android 11+ (API 30+) - dev/staging builds only.
        The production flavor removes this via the src/production overlay
        (tools:node="remove", #75); the Play build ships without it.
        Never requested at runtime (helpers removed in #81); kept so a
        developer can grant it manually in Settings for broad-access testing.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" 
        android:minSdkVersion="30"
        tools:ignore="ScopedStorage" />

    <!-- 
        ============================================================================
        HARDWARE FEATURES (Optional)
        ============================================================================
        Marking as not required allows installation on more device types
    -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="${appIcon}"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:theme="@style/LaunchTheme"
        android:networkSecurityConfig="${networkSecurityConfig}"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <!-- App launch intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            
            <!-- Handle Internet Archive URLs - /details/ pattern -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="archive.org"
                    android:pathPrefix="/details/" />
            </intent-filter>
            
            <!-- Handle Internet Archive URLs - /download/ pattern -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="archive.org"
                    android:pathPrefix="/download/" />
            </intent-filter>
            
            <!-- Handle custom deep links (ia-get://identifier) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="iaget" />
            </intent-filter>
        </activity>
        
        <!-- File provider for sharing downloaded files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
            
        <!-- App metadata for store listing -->
        <meta-data
            android:name="com.gameaday.iahelper.APP_VERSION"
            android:value="@string/version_name" />
            
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    
    <!-- Queries for Intent resolution (Android 11+) -->
    <queries>
        <!-- Web browsing -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        
        <!-- File sharing -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>

        <!-- Opening downloaded files with external apps (ACTION_VIEW with a
             file MIME type; needed for package visibility on Android 11+) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
</manifest>
