<?xml version="1.0" encoding="utf-8"?>
<!--
    Production (Play Store) flavor overlay - issue #75, Option B.
    Removes MANAGE_EXTERNAL_STORAGE from the Play build so the listing
    needs no All-Files-Access declaration video and carries no broad-storage
    rejection risk. Scoped storage is the only path on this flavor; the Dart
    manage-storage request degrades gracefully (returns false). Dev/staging
    builds keep the permission via the main manifest.

    Additionally strips every media/storage/notification permission from the
    MERGED manifest (issues #81/#82 + Play photo/video permissions policy,
    support.google.com/googleplay/android-developer/answer/16935362).
    A dependency can inject uses-permissions into the merged manifest at
    build time even when the app's own source manifest never declares them;
    tools:node="remove" wins the merge regardless of which library declares
    them. The app never reads the media library and writes only app-scoped
    storage, so these are safe to strip unconditionally on this flavor.
    CI enforces this via the "Guard merged manifest permissions" step.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="remove" />
</manifest>
